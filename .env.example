# Copy this file to .env and adjust values if needed:
#   cp .env.example .env
#
# Why a .env file?
# - Keeps credentials out of source code
# - Makes it easy to change host/port/password without editing scripts
# - Works with both Docker Compose and the Python ETL

POSTGRES_USER=marketvalue
POSTGRES_PASSWORD=marketvalue
POSTGRES_DB=marketvalue
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
